NODE_ENV=development
PORT=4000
BUSINESS_EMAIL=nateriyadravit@gmail.com

# Set these locally to bootstrap the first admin account. Never commit .env.
ADMIN_NAME=DRAVIT NATERIYA
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Optional SMTP delivery. Without these values, inquiries and orders are saved,
# but email notifications are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional paths; defaults are data/dravit.sqlite and storage/private.
DRAVIT_DATABASE_FILE=
DRAVIT_UPLOAD_DIRECTORY=
